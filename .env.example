# Copy to .env.local and fill in from Supabase:
#   Dashboard → Project Settings → API Keys (and Data API for the URL)

# Public values: safe in the browser. Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SERVER ONLY. Used to upload listing images after server-side validation.
# Never prefix this with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
